# Newsletter signup. Full-access Resend key (sending-only keys cannot write contacts).
# Vercel project, server-side only.
RESEND_API_KEY=

# Homepage GitHub contribution count. Server-side only. Never prefix with VITE_.
# Fine-grained or classic personal access token with no scopes (public data only).
# See the README for what to set in Vercel.
GITHUB_TOKEN=
